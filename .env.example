# PostgreSQL
POSTGRES_USER=observa
POSTGRES_PASSWORD=   # REQUIRED — change this before starting
POSTGRES_DB=inaturalist

# PostgREST API user (read-only, least-privilege)
API_USER_PASSWORD=   # REQUIRED — change this before starting

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=   # REQUIRED — change this before starting
# Interface Grafana listens on. 127.0.0.1 keeps it local to this machine; set
# 0.0.0.0 to reach it from other hosts (put it behind TLS if it's on a network).
GRAFANA_BIND=127.0.0.1
# Public URL users reach Grafana at, for links in alerts and redirects. Set it
# when Grafana sits behind a reverse proxy or a hostname.
# GRAFANA_ROOT_URL=https://grafana.example.com/

# REST API (nginx in front of PostgREST)
# Interface the API listens on, same meaning as GRAFANA_BIND.
API_BIND=127.0.0.1
# Public URL of the API, used in the OpenAPI document. Set it behind a proxy.
# API_PUBLIC_URL=https://api.example.com

# PostgreSQL memory (defaults suit a ~16 GB host; see "PostgreSQL tuning" in the README)
# PG_SHARED_BUFFERS=4GB
# PG_EFFECTIVE_CACHE_SIZE=12GB
# PG_WORK_MEM=256MB
# PG_MAINTENANCE_WORK_MEM=2GB

# Alerting (optional — leave blank to disable Slack notifications)
SLACK_WEBHOOK_URL=

# Importer schedule (cron expression)
IMPORT_CRON=0 3 * * *

# Maximum allowed row count drop percentage before aborting import (default: 50%)
ROW_DROP_THRESHOLD=50

# Set to false to turn off scheduled backups (the data can be re-imported)
BACKUP_ENABLED=true

# Backup schedule (cron expression, default: weekly Sunday 2 AM)
BACKUP_CRON=0 2 * * 0

# Backup retention (number of backups to keep)
BACKUP_RETENTION=4
